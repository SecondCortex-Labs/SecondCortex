{
  "name": "secondcortex",
  "displayName": "SecondCortex",
  "description": "Remembers what you were working on, answers questions about it, and takes you back to it. Talks to a SecondCortex server on your own machine.",
  "version": "0.2.0",
  "publisher": "secondcortex-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Syed-Suhaan/SecondCortex-Labs"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "memory",
    "context",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "secondcortex",
          "title": "SecondCortex",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "secondcortex": [
        {
          "type": "webview",
          "id": "secondcortex.sidebar",
          "name": "Ask"
        }
      ]
    },
    "commands": [
      {
        "command": "secondcortex.resurrectWorkspace",
        "title": "Resurrect Workspace",
        "category": "SecondCortex"
      },
      {
        "command": "secondcortex.askQuestion",
        "title": "Ask a Question",
        "category": "SecondCortex"
      },
      {
        "command": "secondcortex.toggleCapture",
        "title": "Toggle Capture",
        "category": "SecondCortex"
      }
    ],
    "configuration": {
      "title": "SecondCortex",
      "properties": {
        "secondcortex.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8732",
          "markdownDescription": "Address of the local SecondCortex server started with `python -m secondcortex serve`. The server accepts only `127.0.0.1` or `localhost`."
        },
        "secondcortex.captureEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Take snapshots while you edit and save."
        },
        "secondcortex.debouncerDelayMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Milliseconds after your last edit to a file before a snapshot of it is taken. Saving takes one immediately."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/unit/*.test.js\"",
    "test:integration": "npm run compile && node out/test/integration/run.js",
    "vsix": "npx @vscode/vsce package",
    "publish:patch": "npx @vscode/vsce publish patch",
    "publish:minor": "npx @vscode/vsce publish minor",
    "publish:major": "npx @vscode/vsce publish major"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^2.3.8",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "minimatch": "^9.0.0"
  }
}
